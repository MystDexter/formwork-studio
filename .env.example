# Public URL used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://formwork.studio

# Optional: where the contact form forwards enquiries (JSON POST).
# Works with Formspree, Basin, Make/Zapier webhooks, Slack workflows, or your own API.
# Leave empty and the form falls back to opening a prefilled email instead.
CONTACT_WEBHOOK_URL=
